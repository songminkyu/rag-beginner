# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Local Model Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=exaone4:1.2b
LOCAL_MODEL_TYPE=exaone
LOCAL_MODEL_SIZE=1.2b
# Available model types: exaone, llama, mistral, codellama, phi, qwen
# EXAONE models: exaone4:32b, exaone4:1.2b
# Llama models: llama3.1:8b, llama3.1:70b, llama2:13b, llama2:70b
# Mistral models: mistral:7b, mixtral:8x7b, mixtral:8x22b
# CodeLlama models: codellama:7b, codellama:13b, codellama:34b
# Phi models: phi3:mini, phi3:medium, phi3:14b
# Qwen models: qwen:7b, qwen:14b, qwen2.5:7b, qwen2.5:14b

# HuggingFace Transformers Configuration
HF_MODEL_NAME=microsoft/DialoGPT-medium
# Popular HF models: microsoft/DialoGPT-medium, microsoft/DialoGPT-large
# Korean models: skt/kogpt2-base-v2, beomi/KcELECTRA-base, beomi/kcbert-base
# Multilingual models: microsoft/DialoGPT-medium, facebook/blenderbot-400M-distill

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
# Multilingual embeddings: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Korean embeddings: jhgan/ko-sroberta-multitask, BM-K/KoSimCSE-roberta
# English embeddings: sentence-transformers/all-MiniLM-L6-v2, sentence-transformers/all-mpnet-base-v2

# Vector Store Configuration
VECTOR_STORE=chromadb  # Options: chromadb, faiss, pinecone
CHROMADB_PATH=./data/vector_stores/chromadb
FAISS_INDEX_PATH=./data/vector_stores/faiss

# Pinecone Configuration (if using Pinecone)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=us-west1-gcp-free
PINECONE_INDEX_NAME=rag-index

# Text Processing Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_TOKENS=4000

# RAG Configuration
RETRIEVAL_K=5  # Number of retrieved documents
SIMILARITY_THRESHOLD=0.7

# Evaluation Configuration
ENABLE_EVALUATION=true
EVAL_DATASET_PATH=./data/datasets/qa_pairs.json

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/rag_system.log

# Performance Configuration
BATCH_SIZE=32
USE_GPU=false
DEVICE=cpu  # Options: cpu, cuda, mps (for Apple Silicon)

# Local Model Optimization
TORCH_DTYPE=float16  # Options: float32, float16, bfloat16
LOW_CPU_MEM_USAGE=true
USE_CACHE=true
KOREAN_OPTIMIZED=true
MAX_NEW_TOKENS=1024

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Gradio Configuration
GRADIO_PORT=7860
GRADIO_SHARE=false

# Development Configuration
DEBUG=false
ENVIRONMENT=development  # Options: development, production